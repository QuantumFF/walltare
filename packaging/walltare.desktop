[Desktop Entry]
Version=1.4
Type=Application
Name=walltare
GenericName=Wallpaper curation
Comment=Decide which wallpapers to keep by comparing them two at a time
# /usr/bin/walltare is the launcher installed from packaging/walltare.sh, not
# the binary. It sets __NV_DISABLE_EXPLICIT_SYNC when the environment has not
# already set it; the binary itself lives in /usr/lib/walltare.
Exec=walltare
Icon=walltare
Terminal=false
Categories=Graphics;Viewer;
Keywords=wallpaper;image;ranking;curation;
StartupNotify=true
# What ties an open window back to this entry, and so to the Icon above. GTK
# names the toplevel `walltare`, the WM_CLASS on X11 and the app_id on
# Wayland, both taken from the binary. A dock or an alt-tab switcher looks
# that string up here to learn what the window is. A matcher that reads this
# field and nothing else found no entry while the field was missing, and drew
# its own placeholder instead of walltare's icon (#223).
StartupWMClass=walltare
